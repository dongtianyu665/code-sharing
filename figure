    "def get_percent(df, treatment, year_value):\n",
    "    \"\"\"获取特定治疗方式和年份的百分比值\"\"\"\n",
    "    result = df[(df['year'] == year_value) & (df['group'] == treatment)]['rate']\n",
    "    \n",
    "    if not result.empty:\n",
    "        return round(result.iloc[0], 2)\n",
    "    else:\n",
    "        return 0.00  # 默认值\n",
    "\n",
    "# 获取所有治疗方式[10](@ref)\n",
    "treatments = df['group'].unique()\n",
    "treatments_list = []\n",
    "\n",
    "# 为每个治疗方式生成标签\n",
    "for treatment in treatments:\n",
    "    percent_2016 = get_percent(df, treatment, 2016)\n",
    "    percent_2024 = get_percent(df, treatment, 2024)\n",
    "    \n",
    "    # 计算年均变化率[6,7](@ref)\n",
    "    if percent_2016 != 0:  # 避免除零错误\n",
    "        annual_change = round((percent_2024 - percent_2016) / 8, 2)\n",
    "    else:\n",
    "        annual_change = 0.00\n",
    "    \n",
    "    label = f\"{treatment} ({percent_2016}% to {percent_2024}%, {annual_change}%)\"\n",
    "    treatments_list.append(label)\n",
    "treatments_list"
   ]
