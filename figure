    "legend.get_frame().set_linewidth(0.5)\n",
    "legend.get_frame().set_boxstyle('round,pad=0.2')\n",
    "\n",
    "# 隐藏轴\n",
    "ax.axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
