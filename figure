    "##增加线性图例\n",
    "#high GDP region from 2016 to 2024\n",
    "# 设置中文字体\n",
    "plt.rcParams['font.family'] = ['Times New Roman', 'SimHei']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# 定义颜色和标签\n",
    "colors = ['#000080', '#808000', '#008080', '#ff9999', '#808080', '#cc99cc']\n",
    "treatments = ['AM', 'LM', 'HM', 'HIFU', 'VM', 'RFA/UAE']\n",
    "\n",
    "# 创建图形和轴\n",
    "fig, ax = plt.subplots(figsize=(8, 6), facecolor='none')\n",
    "\n",
    "# 创建自定义的散点+线段图例元素\n",
    "# 使用Line2D创建一条线段，并在中间添加一个标记来模拟散点加线段的效果\n",
    "legend_elements = [\n",
    "    Line2D(\n",
    "        [0], [0],\n",
    "        color=color,\n",
    "        label=treatment,\n",
    "        marker='o',        # 设置散点标记为圆形\n",
    "        markersize=8,     # 设置标记大小\n",
    "        linestyle='-',     # 设置线条样式为实线\n",
    "        linewidth=3        # 设置线条宽度\n",
    "    )\n",
    "    for color, treatment in zip(colors, treatments)\n",
    "]\n",
    "\n",
    "# 添加图例\n",
    "legend = ax.legend(\n",
    "    handles=legend_elements,\n",
    "    loc='center',\n",
    "    frameon=True,        # 改为True以便看到图例框的圆角效果\n",
    "    fancybox=True,       # 启用圆角边框\n",
    "    shadow=True,         # 启用阴影\n",
    "    prop={'weight': 'bold', \"size\": 12}  # 调整字体大小以适应图形\n",
    ")\n",
    "\n",
    "# 设置图例边框样式\n",
    "legend = ax.legend(handles=legend_elements, loc='center', frameon=True)\n",
    "legend.get_frame().set_facecolor('none')  # 设置背景完全透明[5,8](@ref)\n",
    "legend.get_frame().set_edgecolor('none')  # 去除边框线\n",
    "\n",
    "# 隐藏轴\n",
    "ax.axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
