    "##住院总费用均数（不分GDP，还是pgdp_sszx_zfy，计算gdp=0,1,2时pgdp_sszx_zfy/3）\n",
    "# 设置全局字体：英文使用Times New Roman，中文使用SimHei\n",
    "plt.rcParams['font.family'] = ['Times New Roman', 'SimHei'] \n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# 定义颜色和治疗方案\n",
    "colors = ['#000080', '#808000', '#008080', '#ff9999', '#808080', '#cc99cc']\n",
    "treatments = ['AM', 'LM', 'HM', 'HIFU', 'VM', 'RFA/UAE']\n",
    "\n",
    "# 创建图形和坐标轴\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "\n",
    "# 设置图形内部的背景为透明\n",
    "fig.patch.set_alpha(0.0)\n",
    "ax.patch.set_alpha(0.0)\n",
    "\n",
    "# 筛选pgdp=0,1,2的数据\n",
    "df_filtered = df[df['pgdp'].isin([0, 1, 2])]\n",
    "\n",
    "# 为每个治疗方案绘制总的平均线\n",
    "for i, (treatment, color) in enumerate(zip(treatments, colors)):\n",
    "    # 筛选当前治疗方案的数据（包含所有pgdp组）\n",
    "    treatment_data = df_filtered[df_filtered['sszx'] == treatment]\n",
    "    \n",
    "    if not treatment_data.empty:\n",
    "        # 按year1分组并计算zfy1的平均值（所有pgdp组的平均）\n",
    "        yearly_means = treatment_data.groupby('year1')['zfy1'].mean().reset_index()\n",
    "        yearly_means = yearly_means.sort_values('year1')\n",
    "        \n",
    "        # 提取x和y数据\n",
    "        x_data = yearly_means['year1'].values\n",
    "        y_data = yearly_means['zfy1'].values\n",
    "        \n",
    "        # 绘制散点\n",
    "        ax.scatter(x_data, y_data, color=color, s=60, alpha=0.7)\n",
    "        \n",
    "        # 绘制拟合线\n",
    "        if len(x_data) > 1:  # 至少需要2个点才能拟合\n",
    "            # 使用numpy的polyfit进行线性拟合\n",
    "            z = np.polyfit(x_data, y_data, 1)  # 1次多项式（线性拟合）\n",
    "            p = np.poly1d(z)\n",
    "            \n",
    "            # 生成拟合线的x值（从最小年份到最大年份）\n",
    "            x_fit = np.linspace(min(x_data), max(x_data), 100)\n",
    "            y_fit = p(x_fit)\n",
    "            \n",
    "            # 绘制拟合\n",
    "            ax.plot(x_fit, y_fit, color=color, linewidth=3, \n",
    "            label=f'{treatment}', alpha=0.8)\n",
    "            # 计算置信区间\n",
    "            # 计算残差\n",
    "            residuals = y_data - p(x_data)\n",
    "            # 计算残差的标准差\n",
    "            residual_std = np.std(residuals)\n",
    "            #计算标准误差\n",
    "            n = len(x_data)\n",
    "            # 计算预测值的标准误差\n",
    "            x_mean = np.mean(x_data)\n",
    "            Sxx = np.sum((x_data - x_mean)**2)\n",
    "            # 计算每个预测点的标准误差\n",
    "            se = residual_std * np.sqrt(1/n + (x_fit - x_mean)**2 / Sxx)\n",
    "            # 计算95%置信区间 (t分布，自由度为n-2)\n",
    "            t_val = stats.t.ppf(0.975, n-2)  # 95%置信水平\n",
    "            ci = t_val * se\n",
    "            \n",
    "            # 绘制95%置信区间阴影\n",
    "            ax.fill_between(x_fit, y_fit - ci, y_fit + ci,color=color, alpha=0.2, zorder=3)\n",
    "\n",
