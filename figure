    "#yydj2_sszx_percent.csv\n",
    "# 设置全局字体：英文使用Times New Roman，中文使用SimHei\n",
    "plt.rcParams['font.family'] = ['Times New Roman', 'SimHei'] \n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# 定义治疗类型和颜色\n",
    "treatments = ['HM', 'LM', 'HIFU']  # 按照sszx分三个图\n",
    "yydj2_groups = sorted(df['yydj2'].unique())  # 获取yydj2分组\n",
    "colors = ['#008080', '#808000']  # 为不同的yydj2组分配颜色\n",
    "\n",
    "# 设置分段点\n",
    "year_inter = 2019  # 可根据需要调整\n",
    "\n",
    "##############################为每个sszx组绘制图形###################\n",
    "for treatment_idx, treatment in enumerate(treatments):\n",
    "    # 创建图形和坐标轴\n",
    "    fig, ax = plt.subplots(figsize=(10, 8))\n",
    "    \n",
    "    # 设置图形内部的背景为透明\n",
    "    fig.patch.set_alpha(0.0)\n",
    "    ax.patch.set_alpha(0.0)\n",
    "    \n",
    "    # 筛选当前治疗类型的数据\n",
    "    treatment_data = df[df['sszx'] == treatment]\n",
    "    \n",
    "    # 为每个yydj2组绘制分段拟合线\n",
    "    for yydj2_idx, (yydj2_val, color) in enumerate(zip(yydj2_groups, colors)):\n",
    "        # 筛选当前yydj2组的数据\n",
    "        group_data = treatment_data[treatment_data['yydj2'] == yydj2_val]\n",
    "        \n",
    "        if not group_data.empty:\n",
    "            # 按year排序\n",
    "            group_data = group_data.sort_values('year')\n",
    "            \n",
    "            # 提取x和y数据\n",
    "            x_data = group_data['year'].values\n",
    "            y_data = group_data['percent'].values\n",
    "            \n",
    "            # 绘制散点\n",
    "            ax.scatter(x_data, y_data, color=color, s=60, alpha=0.7, label=f'yydj2={yydj2_val}')\n",
    "            \n",
    "            # 分段线性拟合：2016年至year_inter和year_inter至2024年\n",
    "            segments = [\n",
    "                (min(x_data), year_inter),  # 第一段\n",
    "                (year_inter, max(x_data))   # 第二段\n",
    "            ]\n",
    "            \n",
    "            for j, (start, end) in enumerate(segments):\n",
    "                # 筛选当前分段的数据\n",
    "                segment_mask = (x_data >= start) & (x_data <= end)\n",
    "                x_segment = x_data[segment_mask]\n",
    "                y_segment = y_data[segment_mask]\n",
    "                \n",
    "                if len(x_segment) > 1:  # 至少需要2个点才能拟合\n",
    "                    # 使用numpy的polyfit进行线性拟合\n",
    "                    z = np.polyfit(x_segment, y_segment, 1)  # 1次多项式（线性拟合）\n",
    "                    p = np.poly1d(z)\n",
    "                    \n",
    "                    # 生成拟合线的x值（从分段开始到分段结束）\n",
    "                    x_fit = np.linspace(start, end, 100)\n",
    "                    y_fit = p(x_fit)\n",
    "                    \n",
    "                    # 绘制拟合线\n",
    "                    # 使用虚线表示分段拟合的连接点\n",
    "                    linestyle = '-' if j == 0 or (x_fit[0] > year_inter) else '-'\n",
    "                    linewidth = 2.5 if j == 0 or (x_fit[0] > year_inter) else 1.5\n",
    "                    \n",
    "                    # 只在第一段显示图例标签，避免重复\n",
    "                    if j == 0:\n",
    "                        ax.plot(x_fit, y_fit, color=color, linewidth=linewidth, \n",
    "                               linestyle=linestyle, alpha=0.9)\n",
    "                    else:\n",
    "                        ax.plot(x_fit, y_fit, color=color, linewidth=linewidth, \n",
    "                               linestyle=linestyle, alpha=0.9)\n",
    "                    \n",
    "                    # 计算置信区间\n",
    "                    # 计算残差\n",
    "                    residuals = y_segment - p(x_segment)\n",
    "                    # 计算残差的标准差\n",
    "                    residual_std = np.std(residuals)\n",
    "                    # 计算标准误差\n",
    "                    n = len(x_segment)\n",
    "                    if n > 2:  # 需要至少3个点来计算置信区间\n",
    "                        # 计算预测值的标准误差\n",
    "                        x_mean = np.mean(x_segment)\n",
    "                        Sxx = np.sum((x_segment - x_mean)**2)\n",
    "                        # 计算每个预测点的标准误差\n",
    "                        se = residual_std * np.sqrt(1/n + (x_fit - x_mean)**2 / Sxx)\n",
    "                        # 计算95%置信区间 (t分布，自由度为n-2)\n",
    "                        t_val = stats.t.ppf(0.975, n-2)  # 95%置信水平\n",
    "                        ci = t_val * se\n",
    "                        \n",
    "                        # 绘制95%置信区间阴影\n",
    "                        ax.fill_between(x_fit, y_fit - ci, y_fit + ci, \n",
    "                                       color=color, alpha=0.2, zorder=3)\n",
    "    \n",
    "    # 添加分段点垂直线，突出显示转折点\n",
    "    ax.axvline(x=year_inter, color='red', linestyle='--', linewidth=2.5, alpha=0.7)\n",
    "    \n",
    "    # 设置Y轴范围\n",
    "    if not treatment_data.empty:\n",
    "        y_max = treatment_data['percent'].max() * 1.2  # 留20%的余量\n",
    "        y_min = max(0, treatment_data['percent'].min() * 0.8)  # 确保最小值不小于0\n",
    "        ax.set_ylim(y_min, y_max)\n",
    "    else:\n",
    "        # 如果没有数据，设置默认范围\n",
    "        y_max = 100\n",
    "        y_min = 0\n",
    "        y_range = y_max - y_min\n",
    "        ax.set_ylim(max(0, y_min - 0.1*y_range), y_max + 0.1*y_range)\n",
    "    \n",
    "    # 设置X轴范围\n",
    "    if not treatment_data.empty:\n",
    "        years = sorted(treatment_data['year'].unique())\n",
    "        if len(years) > 0:\n",
    "            ax.set_xlim(min(years)-0.5, max(years)+0.5)\n",
    "            \n",
    "            # 创建完整的年份范围，包括所有年份\n",
    "            all_years = list(range(min(years), max(years) + 1))\n",
    "            \n",
    "            # 设置X轴刻度\n",
    "            ax.set_xticks(all_years)\n",
    "            ax.set_xticklabels(all_years, fontsize=42, rotation=45, ha='right', fontweight='bold')\n",
    "    else:\n",
    "        # 如果没有数据，设置默认的年份范围\n",
    "        ax.set_xlim(2015.5, 2024.5)\n",
    "        default_years = list(range(2016, 2025))\n",
    "        ax.set_xticks(default_years)\n",
    "        ax.set_xticklabels(default_years, fontsize=42, rotation=45, ha='right', fontweight='bold')\n",
    "    \n",
    "    # 设置Y轴刻度\n",
    "    y_ticks = [0, 20, 40, 60, 80, 100]\n",
    "    ax.set_yticks(y_ticks)\n",
    "    ax.set_yticks([10, 20, 30, 40, 50, 60, 70, 80, 90], minor=True)\n",
    "    ax.set_yticklabels(['0', '20', '40', '60', '80', '100'], fontsize=50, fontweight='bold')\n",
    "    \n",
    "    # 添加网格线\n",
    "    #ax.grid(True, alpha=0.3, linestyle='--', linewidth=0.5)\n",
    "     \n",
    "    # 设置坐标轴标签\n",
    "    ax.set_xlabel('Year', fontsize=42, fontweight='bold', labelpad=20)\n",
    "    ax.set_ylabel('Prevalence (%)', fontsize=42, fontweight='bold', labelpad=20)\n",
    "    \n",
    "    # 移除边框，只保留坐标轴\n",
    "    ax.spines['top'].set_visible(False)\n",
    "    ax.spines['right'].set_visible(False)\n",
    "    ax.spines['left'].set_visible(True)\n",
    "    ax.spines['bottom'].set_visible(True)\n",
    "    \n",
    "    # 加粗坐标轴 - 设置线宽为2.5\n",
    "    ax.spines['left'].set_linewidth(2.5)\n",
    "    ax.spines['bottom'].set_linewidth(2.5)\n",
    "    \n",
    "    # 添加图例\n",
    "    #ax.legend(loc='best', fontsize=36, frameon=False, prop={'weight': 'bold'})\n",
    "    \n",
    "    # 添加标题\n",
