    "# 无分段点\n",
    "# 设置全局字体：英文使用Times New Roman，中文使用SimHei\n",
    "plt.rcParams['font.family'] = ['Times New Roman', 'SimHei'] \n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# 定义颜色（根据描述中的颜色）\n",
    "pgdp_groups = sorted(df['pgdp'].unique())\n",
    "colors = ['#66b3ff','#ff9999','#588979']\n",
    "treatments = [0, 1,2]\n",
    "\n",
    "# 绘制拟合线图 - 单独绘制每个pgdp组的图表\n",
    "for pgdp_val in pgdp_groups:\n",
    "    # 创建图形和坐标轴\n",
    "    fig, ax = plt.subplots(figsize=(10, 8))\n",
    "    \n",
    "    # 设置图形内部的背景为透明\n",
    "    fig.patch.set_alpha(0.0)\n",
    "    ax.patch.set_alpha(0.0)\n",
    "    \n",
    "    # 筛选当前pgdp组的数据\n",
    "    group_data = df[df['pgdp'] == pgdp_val]\n",
    "    \n",
    "    # 为每个治疗方案绘制拟合线\n",
    "    for i, (treatment, color) in enumerate(zip(treatments, colors)):\n",
    "        # 筛选当前治疗方案的数据\n",
    "        treatment_data = group_data[group_data['sszx'] == treatment]\n",
    "        \n",
    "        if not treatment_data.empty:\n",
    "            # 按year1排序\n",
    "            treatment_data = treatment_data.sort_values('year1')\n",
    "            \n",
    "            # 提取x和y数据\n",
    "            x_data = treatment_data['year1'].values\n",
    "            y_data = treatment_data['zfy1'].values\n",
    "            \n",
    "            # 绘制散点\n",
    "            ax.scatter(x_data, y_data, color=color, s=60, alpha=0.7)\n",
    "            \n",
    "            # 绘制拟合线\n",
    "            if len(x_data) > 1:  # 至少需要2个点才能拟合\n",
    "                # 使用numpy的polyfit进行线性拟合\n",
    "                z = np.polyfit(x_data, y_data, 1)  # 1次多项式（线性拟合）\n",
    "                p = np.poly1d(z)\n",
    "                \n",
    "                # 生成拟合线的x值（从最小年份到最大年份）\n",
    "                x_fit = np.linspace(min(x_data), max(x_data), 100)\n",
    "                y_fit = p(x_fit)\n",
    "                \n",
    "                # 绘制拟合线\n",
    "                ax.plot(x_fit, y_fit, color=color, linewidth=1.5, \n",
    "                       label=f'{treatment}', alpha=0.8)\n",
    "                # 计算置信区间\n",
    "                # 计算残差\n",
    "                residuals = y_data - p(x_data)\n",
    "                # 计算残差的标准差\n",
    "                residual_std = np.std(residuals)\n",
    "                # 计算标准误差\n",
    "                n = len(x_data)\n",
    "                # 计算预测值的标准误差\n",
    "                x_mean = np.mean(x_data)\n",
    "                Sxx = np.sum((x_data - x_mean)**2)\n",
    "                # 计算每个预测点的标准误差\n",
    "                se = residual_std * np.sqrt(1/n + (x_fit - x_mean)**2 / Sxx)\n",
    "                # 计算95%置信区间 (t分布，自由度为n-2)\n",
    "                t_val = stats.t.ppf(0.975, n-2)  # 95%置信水平\n",
    "                ci = t_val * se\n",
    "                \n",
    "                # 绘制95%置信区间阴影\n",
    "                ax.fill_between(x_fit, y_fit - ci, y_fit + ci, \n",
    "                               color=color, alpha=0.2, zorder=3)\n",
    "    \n",
    "    # 设置坐标轴范围\n",
    "    # 根据实际数据动态设置y轴范围\n",
    "    y_min = group_data['zfy1'].min() if not group_data.empty else 7000\n",
    "    y_max = group_data['zfy1'].max() if not group_data.empty else 22000\n",
    "    \n",
    "    # 添加一些余量\n",
    "    y_range = y_max - y_min\n",
    "    ax.set_ylim(max(0, y_min - 0.1*y_range), y_max + 0.1*y_range)\n",
    "    \n",
    "    # 设置x轴范围\n",
    "    if not group_data.empty:\n",
    "        years = sorted(group_data['year1'].unique())\n",
    "        if len(years) > 0:\n",
    "            ax.set_xlim(min(years)-0.5, max(years)+0.5)\n",
    "            # 设置X轴刻度\n",
    "            ax.set_xticks(years)\n",
    "            ax.set_xticklabels(years, fontsize=42, rotation=45, ha='right', fontweight='bold')\n",
    "    \n",
    "    # 设置Y轴刻度\n",
    "    y_ticks = np.linspace(0, 100)  # 0到10之间取6个等间隔点\n",
    "    ax.set_yticks([0, 20, 40, 60, 80, 100])\n",
    "    ax.set_yticks([10, 20, 30, 40, 50, 60, 70, 80, 90], minor=True)\n",
    "    ax.set_yticklabels(['0', '20', '40', '60', '80', '100'], fontsize=42,fontweight='bold')\n",
    "     \n",
    "    # 设置坐标轴标签\n",
    "    ax.set_xlabel('Year', fontsize=42, fontweight='bold', labelpad=20)\n",
    "    ax.set_ylabel('Prevalence (%)', fontsize=42, fontweight='bold', labelpad=20)\n",
    "    \n",
    "    # 添加网格线（可选，使图表更易读）\n",
    "    ax.grid(True, alpha=0.3, linestyle='--')\n",
    "    \n",
    "    # 移除边框，只保留坐标轴\n",
    "    ax.spines['top'].set_visible(False)\n",
    "    ax.spines['right'].set_visible(False)\n",
    "    ax.spines['left'].set_visible(True)\n",
    "    ax.spines['bottom'].set_visible(True)\n",
    "    \n",
    "    # 加粗坐标轴 - 设置线宽为2.5\n",
    "    ax.spines['left'].set_linewidth(2.5)\n",
    "    ax.spines['bottom'].set_linewidth(2.5)\n",
    "    \n",
    "    # 添加图例\n",
    "    #ax.legend(loc='best', fontsize=36, frameon=False, prop={'weight': 'bold'})\n",
    "    \n",
    "    # 添加标题\n",
    "    #ax.set_title(f'Fitted Lines by Treatment (pgdp={pgdp_val})', \n",
