    "# 设置全局字体：英文使用Times New Roman，中文使用SimHei\n",
    "plt.rcParams['font.family'] = ['Times New Roman', 'SimHei'] \n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# 定义颜色（根据描述中的颜色）\n",
    "pgdp_groups = sorted(df['pgdp'].unique())\n",
    "colors = ['#000080', '#808000', '#008080', '#ff9999', '#808080', '#cc99cc']\n",
    "treatments = ['AM', 'LM', 'HM', 'HIFU', 'VM', 'Image-guided']\n",
    "\n",
    "# 绘制堆叠柱状图 - 单独绘制每个pgdp组的图表\n",
    "for pgdp_val in pgdp_groups:\n",
    "    # 创建图形和坐标轴\n",
    "    fig, ax = plt.subplots(figsize=(10, 8))\n",
    "    \n",
    "    # 设置图形内部的背景为透明\n",
    "    fig.patch.set_alpha(0.0)\n",
    "    ax.patch.set_alpha(0.0)\n",
    "    \n",
    "    # 筛选当前pgdp组的数据\n",
    "    group_data = df[df['pgdp'] == pgdp_val]\n",
    "    \n",
    "    # 确保年份数据正确\n",
    "    years = sorted(group_data['year'].unique()) \n",
    "    \n",
    "   # 为每个治疗方案的每个年份提取百分比数据\n",
    "    # 创建存储每个治疗方案数据的字典\n",
    "    treatment_percentages = {}\n",
    "    \n",
    "    for treatment in treatments:\n",
    "        treatment_percentages[treatment] = []\n",
    "        for year in years:\n",
    "            # 从group_data中提取对应treatment和year的数据\n",
    "            value = group_data[(group_data['sszx'] == treatment) & (group_data['year'] == year)]\n",
    "            if not value.empty:\n",
    "                treatment_percentages[treatment].append(value['percent'].iloc[0])\n",
    "            else:\n",
    "                # 如果没有数据，填充0\n",
    "                treatment_percentages[treatment].append(0)\n",
    "    \n",
    "    # 初始化底部位置数组\n",
    "    bottom = np.zeros(len(years))\n",
    "    \n",
    "    # 绘制每个治疗方案的堆叠柱状图\n",
    "    for i, (treatment, color) in enumerate(zip(treatments, colors)):\n",
    "        # 获取当前治疗方案的百分比数据\n",
    "        values = treatment_percentages[treatment]\n",
    "        \n",
    "        # 绘制堆叠柱状图\n",
    "        ax.bar(years, values, bottom=bottom, color=color, label=treatment, width=0.6)\n",
    "        bottom += values\n",
    "    \n",
    "    # 设置坐标轴范围\n",
    "    ax.set_ylim(0, 100)\n",
    "    # 根据实际数据年份设置x轴范围\n",
    "    if len(years) > 0:\n",
    "        ax.set_xlim(min(years)-0.5, max(years)+0.5)\n",
    "    \n",
    "        #ax.set_ylim(0, 100)\n",
    "        #ax.set_xlim(2015.5, 2024.5)\n",
    "\n",
    "        # 设置Y轴刻度\n",
    "        ax.set_yticks([0, 20, 40, 60, 80, 100])\n",
    "        ax.set_yticks([10, 20, 30, 40, 50, 60, 70, 80, 90], minor=True)\n",
    "        ax.set_yticklabels(['0%', '20%', '40%', '60%', '80%', '100%'], fontsize=50,fontweight='bold')\n",
    "\n",
    "        # 设置X轴刻度\n",
    "        ax.set_xticks(years)\n",
    "        ax.set_xticklabels(years, fontsize=42,rotation=45, ha='right',fontweight='bold')\n",
    "\n",
    "        # 移除边框，只保留坐标轴\n",
    "        ax.spines['top'].set_visible(False)\n",
    "        ax.spines['right'].set_visible(False)\n",
    "        ax.spines['left'].set_visible(True)\n",
    "        ax.spines['bottom'].set_visible(True)\n",
    "        # 加粗坐标轴 - 设置线宽为2.5\n",
    "        ax.spines['left'].set_linewidth(2.5)\n",
    "        ax.spines['bottom'].set_linewidth(2.5)\n",
    "        # 添加图例\n",
    "        #ax.legend(group_data['sszx'], loc='upper right', bbox_to_anchor=(2, 1),frameon=False,prop={'weight': 'bold',\"size\":36})\n",
    "\n",
    "        # 调整布局\n",
    "        plt.tight_layout()\n"
   ]
