    "    y_ticks = np.linspace(0, 10, 6)  # 0到10之间取6个等间隔点\n",
    "    ax.set_yticks(y_ticks)\n",
    "    ax.set_yticklabels([f'{int(tick)}' for tick in y_ticks], fontsize=50, fontweight='bold')\n",
    "    \n",
    "    # 设置X轴范围\n",
    "    if not treatment_data.empty:\n",
    "        years = sorted(treatment_data['year1'].unique())\n",
