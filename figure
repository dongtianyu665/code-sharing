    "# 自写函数提取\n",
    "def get_zfy1(sszx_value, year_value,pgdp_value):\n",
    "    result = df[(df['sszx'] == sszx_value) & \n",
    "                (df['year1'] == year_value) & \n",
    "                (df['pgdp'] == pgdp_value)]['zfy1']\n",
    "    if not result.empty:\n",
    "        return round(result.iloc[0], 2)\n",
    "    else:\n",
    "        return 0.00  #错误值\n",
    "# 设置中文字体\n",
    "plt.rcParams['font.family'] = ['Times New Roman', 'SimHei']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "colors = ['#000080', '#808000', '#008080', '#ff9999', '#808080', '#cc99cc']\n",
    "treatments = ['AM', 'LM', 'HM', 'HIFU', 'VM', 'Image-guided']\n",
    "\n",
    "# 获取唯一的分组值\n",
    "pgdp_groups = sorted(df['pgdp'].unique())\n",
    "\n",
    "# 为每个分组创建一幅图\n",
    "for pgdp_val in pgdp_groups:\n",
    "    # 为当前分组新建一个空的标签列表\n",
    "    treatments_list = []\n",
    "    \n",
    "    # 筛选当前pgdp组的数据\n",
    "    group_data = df[df['pgdp'] == pgdp_val]\n",
    "    \n",
    "    # 为当前分组的每个治疗方式生成标签\n",
    "    for treatment in treatments:\n",
    "        zfy1_2016 = get_zfy1(treatment, 2016,pgdp_val)\n",
    "        zfy1_2024 = get_zfy1(treatment, 2024,pgdp_val)\n",
    "        zfy1=round((zfy1_2024-zfy1_2016)/8,2)\n",
