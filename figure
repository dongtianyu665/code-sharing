    "# 自写函数提取\n",
    "def get_percent(sszx_value, year_value,yydj2_value):\n",
    "    result = df[(df['sszx'] == sszx_value) & \n",
    "                (df['year'] == year_value) & \n",
    "                (df['group'] == yydj2_value)]['percent']\n",
    "    \n",
    "    if not result.empty:\n",
    "        return round(result.iloc[0], 2)\n",
    "    else:\n",
    "        return 0.00  #错误值\n",
    "# 设置中文字体\n",
    "plt.rcParams['font.family'] = ['Times New Roman', 'SimHei']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "colors = ['#000080', '#808000', '#008080', '#ff9999', '#808080', '#cc99cc']\n",
    "treatments = ['AM', 'LM', 'HM', 'HIFU', 'VM', 'RFA/UAE'] # 预定义治疗方式\n",
    "\n",
    "# 获取唯一的分组值\n",
    "yydj2_groups = sorted(df['yydj2'].unique())\n",
    "\n",
    "# 为每个分组创建一幅图\n",
    "for yydj2_val in yydj2_groups:\n",
    "    # 为当前分组新建一个空的标签列表\n",
    "    treatments_list = []\n",
    "    \n",
    "    # 筛选当前yydj2组的数据\n",
    "    group_data = df[df['yydj2'] == yydj2_val]\n",
    "    \n",
    "    # 为当前分组的每个治疗方式生成标签\n",
    "    for treatment in treatments:\n",
    "        percent_2016 = get_percent(treatment, 2016,yydj2_val)\n",
    "        percent_2024 = get_percent(treatment, 2024,yydj2_val)\n",
    "        percent=round((percent_2024-percent_2016)/8,2)\n",
    "        label = f\"{treatment} ({percent_2016}% to {percent_2024}%, {percent}%)\"\n",
    "        treatments_list.append(label)\n",
    "    \n",
    "    # 为当前分组创建独立的图形和轴\n",
    "    fig, ax = plt.subplots(figsize=(8, 6), facecolor='none')\n",
    "    \n",
    "    # 使用当前分组的标签列表创建图例\n",
    "    legend_elements = [mpatches.Patch(color=color, label=treatment_label, edgecolor='black', linewidth=0.5) \n",
    "                      for color, treatment_label in zip(colors, treatments_list)]\n",
    "    \n",
    "    legend = ax.legend(handles=legend_elements, \n",
    "                      loc='center', \n",
    "                      frameon=False,\n",
    "                      fancybox=True,\n",
    "                      shadow=True,\n",
    "                      prop={'weight': 'bold', \"size\": 36},\n",
    "                      edgecolor='none'\n",
    "                      )\n",
    "    legend.get_frame().set_linewidth(0.5)\n",
    "    legend.get_frame().set_boxstyle('round,pad=0.2')\n",
    "    ax.axis('off')\n",
    "    \n",
    "    # 可以为每张图添加一个标题以区分分组\n",
    "    ax.set_title(f'Treatment Distribution for Group: {yydj2_val}', pad=20, fontsize=14)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    # 每循环一次，显示一张图\n",
    "    plt.show()"
   ]
